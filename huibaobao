<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Love You</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #ff9a9e, #fad0c4);
            height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            font-family: 'Arial', sans-serif;
        }

        .container {
            text-align: center;
            padding: 2rem;
            background: rgba(255, 255, 255, 0.9);
            border-radius: 15px;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
            max-width: 600px;
            width: 90%;
        }

        .image-container {
            margin-bottom: 1.5rem;
        }

        .image-container img {
            max-width: 300px;
            height: auto;
            border-radius: 10px;
        }

        .music-player {
            margin-bottom: 1.5rem;
        }

        .message {
            font-size: 1.2rem;
            color: #333;
            margin-bottom: 1rem;
        }

        .love-text {
            font-size: 1.5rem;
            color: #ff3f6b;
            font-weight: bold;
            margin-bottom: 2rem;
        }

        .heart {
            font-size: 4rem;
            color: #ff3f6b;
            animation: beat 1s infinite;
        }

        @keyframes beat {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.2); }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="image-container">
            < img src="your-image.jpg" alt="Our Love">
        </div>

        <div class="music-player">
            <audio controls autoplay>
                <source src="your-audio.mp3" type="audio/mpeg">
                Your browser does not support the audio element.
            </audio>
        </div>

        <div class="message">
            <p>亲爱的[女朋友的名字],</p >
            <p>在这个特别的日子里，我想对你说：</p >
            <p id="love-text">"我永远爱你 ❤️"</p >
        </div>

        <div class="heart">
            ❤️
        </div>
    </div>

    <script>
        // 自动播放音乐（根据浏览器政策可能会有提示）
        document.querySelector('audio').play().catch(() => {
            console.log('Audio autoplay failed');
        });

        // 示例：动态显示文字
        const loveText = document.getElementById('love-text');
        const messages = [
            "每一天都想和你在一起",
            "你是我的唯一",
            "无论未来怎样，我都会在你身边"
        ];

        let currentIndex = 0;

        setInterval(() => {
            loveText.textContent = messages[currentIndex];
            currentIndex = (currentIndex + 1) % messages.length;
        }, 3000);
    </script>
</body>
</html>
